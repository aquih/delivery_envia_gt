<?xml version="1.0" encoding="utf-8"?>
<openerp>

    <record id="view_delivery_carrier_form_inherit_delivery_envia" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.delivery.envia</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <page name="destination" position="before">
                <page string="Envía Configuration" name="envia_configuration" invisible="delivery_type != 'envia'">
                    <group>
                        <group>
                            <field name="envia_usuario" required="delivery_type == 'envia'"/>
                            <field name="envia_clave" required="delivery_type == 'envia'"/>
                            <field name="envia_tipo_envio" required="delivery_type == 'envia'"/>
                            <field name="envia_precio" required="delivery_type == 'envia'"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

</openerp>
